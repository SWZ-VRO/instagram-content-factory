# Copy this file to .env and fill in real values before running
# `docker compose up` (see README).

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (docker-compose overrides this to point at the postgres
# service automatically -- only relevant if you run the backend outside
# Docker) ---
DATABASE_URL=postgresql+psycopg://icf:icf@localhost:5432/icf

# --- Redis (Phase 2+) ---
REDIS_URL=redis://localhost:6379/0

# --- Secrets ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Used to encrypt Instagram access tokens at rest. Changing this after
# accounts are connected invalidates every stored token (§53).
SECRET_KEY=change-me-generate-a-real-secret

# --- Content pipeline ---
CONTENT_ROOT=content

# --- Business rules (see backend/core/config.py for the full list) ---
MIN_VARIANTS=5
MAX_VARIANTS=10
MIN_MASTER_GAP_DAYS=2
REQUIRE_CAPTION=true

DAY_1_3_POSTS=2
DAY_4_7_POSTS=3
DAY_8_30_MIN_POSTS=3
DAY_8_30_MAX_POSTS=5
CALENDAR_DAYS=30

# --- Publishing ---
# MUST stay true until you're ready to publish for real. See README
# "Instagram connection". While true, the Publishing Worker still runs and
# logs what it WOULD have done, but never calls Instagram (§36).
DRY_RUN=true
PUBLISHER=instagram_official

IG_MAX_PUBLISHES_PER_ACCOUNT_PER_DAY=25
IG_MAX_API_CALLS_PER_ACCOUNT_PER_HOUR=200

# --- Video pipeline (Phase 2) ---
WATCHER_ENABLED=true
WATCHER_POLL_INTERVAL_SECONDS=5

# --- Instagram OAuth (Phase 5) ---
# All blank = the "Connect Instagram" OAuth button is disabled (returns 501)
# but the manual-token connect flow (POST /accounts/{id}/connect/manual)
# still works -- see README "Instagram connection". Fill these in only once
# you have a real Meta Developer App with App Review approved for
# instagram_business_basic + instagram_business_content_publish.
IG_APP_ID=
IG_APP_SECRET=
IG_OAUTH_REDIRECT_URI=

# Instagram fetches video from a public HTTPS URL -- it cannot use a
# direct upload. Set this to wherever the backend is actually reachable
# from the internet (a real domain, or an ngrok/cloudflared tunnel in dev).
# Required before ANY real (non-dry-run) publish can succeed.
PUBLIC_BASE_URL=

# --- Publishing Worker (Phase 5) ---
PUBLISHING_WORKER_ENABLED=true
PUBLISHING_POLL_INTERVAL_SECONDS=30
MAX_PUBLISH_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=60
